{
  "name": "@octarine/vue",
  "version": "0.1.0",
  "description": "Octarine Vue 3 components, styled with the @octarine/tailwind theme.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@octarine/i18n": "workspace:*",
    "@octarine/icons": "workspace:*",
    "@octarine/tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "@octarine/tailwind": "workspace:*",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@octarine/tailwind": "workspace:*",
    "@storybook/vue3-vite": "^10.6.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.2",
    "storybook": "^10.6.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.13"
  }
}

{
  "name": "@octarine/i18n",
  "version": "0.1.0",
  "description": "Every text Octarine writes, one JSON file per language, and the formatter that fills in parameters, dates and plurals. No Vue and no DOM.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locales/*.json": "./locales/*.json"
  },
  "files": [
    "dist",
    "locales"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}

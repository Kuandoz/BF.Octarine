{
  "name": "@octarine/form-engine",
  "version": "0.1.0",
  "description": "Headless engine that renders forms from a JSON definition: model, validation, conditions, localisation and lists.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@nyariv/sandboxjs": "^0.9.6",
    "mitt": "^3.0.1"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.13"
  }
}
